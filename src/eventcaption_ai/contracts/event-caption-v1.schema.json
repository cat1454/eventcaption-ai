{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:causalstream:event-caption:1",
  "title": "Append-only observed event caption, independent of forecast contracts",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "session_id", "sequence_no", "record_id", "event_id", "version", "previous_record_id", "operation", "text", "start_ms", "end_ms", "event_status", "evidence_cutoff_ms", "evidence_refs", "evidence_timestamps", "emitted_elapsed_ms", "provenance"],
  "properties": {
    "schema_version": {"const": "event-caption/1"},
    "session_id": {"type": "string", "minLength": 1},
    "sequence_no": {"type": "integer", "minimum": 1},
    "record_id": {"type": "string", "minLength": 1},
    "event_id": {"type": "string", "minLength": 1},
    "version": {"type": "integer", "minimum": 1},
    "previous_record_id": {"type": ["string", "null"], "minLength": 1},
    "operation": {"enum": ["create", "revise", "withdraw"]},
    "text": {"type": "string", "minLength": 1, "maxLength": 500},
    "start_ms": {"type": "number", "minimum": 0},
    "end_ms": {"type": ["number", "null"], "minimum": 0},
    "event_status": {"enum": ["ongoing", "ended"]},
    "evidence_cutoff_ms": {"type": "number", "minimum": 0},
    "evidence_refs": {"type": "array", "minItems": 1, "maxItems": 32, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "evidence_timestamps": {"type": "object", "minProperties": 1, "additionalProperties": {"type": "number", "minimum": 0}},
    "emitted_elapsed_ms": {"type": "number", "minimum": 0},
    "provenance": {"type": "object"}
  },
  "allOf": [
    {"if": {"properties": {"event_status": {"const": "ongoing"}}}, "then": {"properties": {"end_ms": {"type": "null"}}}, "else": {"properties": {"end_ms": {"type": "number"}}}},
    {"if": {"properties": {"operation": {"const": "create"}}}, "then": {"properties": {"version": {"const": 1}, "previous_record_id": {"type": "null"}}}, "else": {"properties": {"version": {"minimum": 2}, "previous_record_id": {"type": "string"}}}}
  ]
}
